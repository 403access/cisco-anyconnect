# Exclude all top-level hidden files and directories by convention
/.*

# Exclude nested package ignore files
**/.gitignore
**/.npmignore

# Exclude TypeScript project configuration and incremental build caches
**/tsconfig.json
**/tsconfig.all.json
**/tsconfig.*.json
**/*.tsbuildinfo

# Exclude monorepo build configuration
/turbo.json
/pnpm-workspace.yaml

# Exclude test configuration
**/jest.config.*
**/jest.setup.*
**/jest-setup.*

# Exclude tarballs generated by `npm pack`
/*.tgz

__mocks__
__tests__

/DEVELOPMENT.md
/CONTRIBUTING.md

/eslint.config.cjs
/babel.config.js
/internal/module_scripts/
/android/src/androidTest/**
/android/src/test/**
/android/build/**
/example/
