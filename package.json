{
  "name": "expo-cisco-anyconnect",
  "version": "0.1.0",
  "description": "Drive the Cisco Secure Client (AnyConnect) app from a React Native / Expo app via Cisco's documented anyconnect:// URI handler.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/prepare.js",
    "build:watch": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js && node internal/module_scripts/clean.js plugin",
    "lint": "eslint src/ plugin/src/",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "cisco",
    "anyconnect",
    "secure-client",
    "vpn",
    "uri-handler"
  ],
  "repository": "https://github.com/example/expo-cisco-anyconnect",
  "bugs": {
    "url": "https://github.com/example/expo-cisco-anyconnect/issues"
  },
  "author": "Cisco AnyConnect Module <dev@example.com> (https://github.com/example)",
  "license": "MIT",
  "homepage": "https://github.com/example/expo-cisco-anyconnect#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.15",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "^58.0.11",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.11",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/plugin/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
